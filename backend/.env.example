# Salin file ini menjadi backend/.env lalu isi nilainya. JANGAN commit file .env ke GitHub.
# Di Emergent, isi variabel ini lewat pengaturan Environment/Secrets proyek.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=nama_toko_db

# --- Keamanan ---
JWT_SECRET=ganti-dengan-teks-acak-panjang
ADMIN_EMAIL=admin@domainanda.com
# Password awal admin. Wajib diganti saat login pertama.
ADMIN_PASSWORD=ganti-password-awal
CORS_ORIGINS=https://domainanda.com,https://www.domainanda.com
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?domainanda\.com$
WEBHOOK_CRON_SECRET=ganti-dengan-teks-acak

# --- Pembayaran Midtrans (ambil di dashboard.midtrans.com > Settings > Access Keys) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = produksi (uang sungguhan), false = sandbox (uji coba)
MIDTRANS_IS_PRODUCTION=false

# --- Ongkir & kurir Biteship (opsional, tanpa ini dipakai tarif tetap) ---
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=ganti-dengan-teks-acak
# Kode pos titik jemput toko. Kosongkan untuk memakai city.originPostal di brand.config.json
BITESHIP_ORIGIN_POSTAL=

# --- WhatsApp & OTP via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE=
TWILIO_WHATSAPP_FROM=+62xxxxxxxxxx
TWILIO_WA_TEMPLATE_SID=
TWILIO_OTP_CHANNEL=whatsapp
OTP_SIGNUP_REQUIRED=false

# --- Email & AI (disediakan Emergent) ---
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Nama Toko Anda
EMAIL_REPLY_TO=
EMERGENT_LLM_KEY=
INTEGRATION_PROXY_URL=

# --- Lain-lain ---
# Nilai 1 poin dalam rupiah saat ditukar ke saldo
POINT_VALUE=10
